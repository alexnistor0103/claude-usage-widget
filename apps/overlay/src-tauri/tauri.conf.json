{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Usage Widget",
  "mainBinaryName": "cuw-overlay",
  "version": "0.3.0",
  "identifier": "com.local.cuw",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Claude Usage Widget",
        "width": 360,
        "height": 340,
        "minWidth": 240,
        "minHeight": 140,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM2NjIzRkMyNUI4NEUzODQKUldTRTQ0UmJ3ajlpeHNXQ0JyNUVCM21vSm82c0ZRSWFjMVVka1kzVkNJV0gwSFRSTVVlMnB2cHIK",
      "endpoints": [
        "https://github.com/alexnistor0103/claude-usage-widget/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
